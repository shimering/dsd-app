{
  "name": "smile-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:edge": "deno check --config supabase/functions/smile-assist/deno.local.json supabase/functions/smile-assist/index.ts",
    "build:cloudflare": "npm test && npm run build",
    "deploy:preview": "wrangler deploy --env preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "idb-keyval": "6.2.2",
    "lucide-react": "0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "deno": "2.5.6",
    "prettier": "3.6.2",
    "supabase": "2.118.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
